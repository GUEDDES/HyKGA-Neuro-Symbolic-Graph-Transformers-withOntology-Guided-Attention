<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://hykga.org/ontology/social_discourse#"
     xml:base="http://hykga.org/ontology/social_discourse"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sioc="http://rdfs.org/sioc/ns#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:schema="https://schema.org/"
     xmlns:marl="http://www.gsi.dit.upm.es/ontologies/marl/ns#"
     xmlns:sh="http://www.w3.org/ns/shacl#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">

    <owl:Ontology rdf:about="http://hykga.org/ontology/social_discourse">
        <rdfs:label>HyKGA Social Discourse Ontology (W3C OWL 2 DL TBox + Closed-World SHACL Shapes + SWRL Rules)</rdfs:label>
        <rdfs:comment>Formal Description Logic ontology O = (C, R, A, S) grounded in W3C SIOC, FOAF, Geo, Schema.org, and Marl for neuro-symbolic logit-masked Graph Transformers in social discourse analysis.</rdfs:comment>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ===================================================================== -->
    <!-- 1. Atomic Entity Concepts C (7 pairwise disjoint classes, SIOC-mapped) -->
    <!-- ===================================================================== -->

    <owl:Class rdf:about="#User">
        <rdfs:label>User</rdfs:label>
        <rdfs:comment>A registered social media user account or actor node in the interaction graph.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/OnlineAccount"/>
    </owl:Class>

    <owl:Class rdf:about="#Message">
        <rdfs:label>Message</rdfs:label>
        <rdfs:comment>A timestamped social media post (tweet, reply, Reddit submission, or comment) subject to functional authorship and sentiment cardinality constraints (Equation 11).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <!-- Qualified Cardinality Constraint 1: Message <= 1 authored_by.User (Eq. 11) -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#authored_by"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#User"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <!-- Qualified Cardinality Constraint 2: Message <= 1 expresses_sentiment.Sentiment (Eq. 11) -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#expresses_sentiment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Sentiment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Hashtag">
        <rdfs:label>Hashtag</rdfs:label>
        <rdfs:comment>An explicit platform hashtag (#tag) or community flair tag indexing a post.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Tag"/>
    </owl:Class>

    <owl:Class rdf:about="#Topic">
        <rdfs:label>Topic</rdfs:label>
        <rdfs:comment>A discursive subject, thematic category, or named discussion topic.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Category"/>
    </owl:Class>

    <owl:Class rdf:about="#Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>A geographic place, city, country, or spatial entity referenced in discourse or user profiles.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:Class>

    <owl:Class rdf:about="#Event">
        <rdfs:label>Event</rdfs:label>
        <rdfs:comment>A real-world event, conference, summit, or breaking-news incident discussed in social streams.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
    </owl:Class>

    <owl:Class rdf:about="#Sentiment">
        <rdfs:label>Sentiment</rdfs:label>
        <rdfs:comment>An evaluative affective or stance polarity expression (positive, negative, neutral) borne by a message.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.gsi.dit.upm.es/ontologies/marl/ns#Opinion"/>
    </owl:Class>

    <!-- Exhaustive Pairwise Concept Disjointness Axiom: DisjointClasses(C) -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#User"/>
            <rdf:Description rdf:about="#Message"/>
            <rdf:Description rdf:about="#Topic"/>
            <rdf:Description rdf:about="#Location"/>
            <rdf:Description rdf:about="#Sentiment"/>
            <rdf:Description rdf:about="#Event"/>
            <rdf:Description rdf:about="#Hashtag"/>
        </owl:members>
    </rdf:Description>

    <!-- ===================================================================== -->
    <!-- 2. Cross-Platform SIOC Subclass Mappings (Section 3.2.2, RumourEval)   -->
    <!-- ===================================================================== -->

    <owl:Class rdf:about="#Submission">
        <rdfs:label>Submission</rdfs:label>
        <rdfs:comment>Cross-platform Reddit root thread submission mapped to Message via W3C SIOC.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Message"/>
    </owl:Class>

    <owl:Class rdf:about="#Comment">
        <rdfs:label>Comment</rdfs:label>
        <rdfs:comment>Cross-platform Reddit or federated reply comment mapped to Message via W3C SIOC.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Message"/>
    </owl:Class>

    <!-- ===================================================================== -->
    <!-- 3. Directed Binary Relations R and Open-World TBox Axioms A (Eqs. 5-10)-->
    <!-- ===================================================================== -->

    <!-- authored_by: Message x User (Functional) -->
    <owl:ObjectProperty rdf:about="#authored_by">
        <rdfs:label>authored_by</rdfs:label>
        <rdfs:comment>Links a Message to the User account that created it (functional role: at most one author per message).</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#has_creator"/>
        <rdfs:domain rdf:resource="#Message"/>
        <rdfs:range rdf:resource="#User"/>
    </owl:ObjectProperty>

    <!-- mentions: Message x (User U Hashtag U Topic U Event) -->
    <owl:ObjectProperty rdf:about="#mentions">
        <rdfs:label>mentions</rdfs:label>
        <rdfs:comment>Links a Message to a User, Hashtag, Topic, or Event explicitly referenced in its text.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#links_to"/>
        <rdfs:domain rdf:resource="#Message"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#User"/>
                    <rdf:Description rdf:about="#Hashtag"/>
                    <rdf:Description rdf:about="#Topic"/>
                    <rdf:Description rdf:about="#Event"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <!-- located_in: (Message U User U Event) x Location -->
    <owl:ObjectProperty rdf:about="#located_in">
        <rdfs:label>located_in</rdfs:label>
        <rdfs:comment>Associates a Message, User, or Event with its geographic Location.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#location"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Message"/>
                    <rdf:Description rdf:about="#User"/>
                    <rdf:Description rdf:about="#Event"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="#Location"/>
    </owl:ObjectProperty>

    <!-- expresses_sentiment: Message x Sentiment (Functional) -->
    <owl:ObjectProperty rdf:about="#expresses_sentiment">
        <rdfs:label>expresses_sentiment</rdfs:label>
        <rdfs:comment>Links a Message to its primary evaluative Sentiment polarity (functional role: at most one primary sentiment per message).</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://www.gsi.dit.upm.es/ontologies/marl/ns#hasOpinion"/>
        <rdfs:domain rdf:resource="#Message"/>
        <rdfs:range rdf:resource="#Sentiment"/>
    </owl:ObjectProperty>

    <!-- follows: User x User (Irreflexive) -->
    <owl:ObjectProperty rdf:about="#follows">
        <rdfs:label>follows</rdfs:label>
        <rdfs:comment>Directed social subscription link from one User to another distinct User (irreflexive: a user cannot follow themselves).</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#follows"/>
        <rdfs:domain rdf:resource="#User"/>
        <rdfs:range rdf:resource="#User"/>
    </owl:ObjectProperty>

    <!-- interacts_with: User x User -->
    <owl:ObjectProperty rdf:about="#interacts_with">
        <rdfs:label>interacts_with</rdfs:label>
        <rdfs:comment>Directed conversational or engagement interaction between Users.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/knows"/>
        <rdfs:domain rdf:resource="#User"/>
        <rdfs:range rdf:resource="#User"/>
    </owl:ObjectProperty>

    <!-- retweets: User x Message -->
    <owl:ObjectProperty rdf:about="#retweets">
        <rdfs:label>retweets</rdfs:label>
        <rdfs:comment>Links a User who reposts, shares, or boosts a Message to that Message.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#shares"/>
        <rdfs:domain rdf:resource="#User"/>
        <rdfs:range rdf:resource="#Message"/>
    </owl:ObjectProperty>

    <!-- ===================================================================== -->
    <!-- 4. Datatype Properties for Causal Temporal & Neuro-Symbolic Grounding  -->
    <!-- ===================================================================== -->

    <owl:DatatypeProperty rdf:about="#hasTimestamp">
        <rdfs:label>hasTimestamp</rdfs:label>
        <rdfs:comment>Continuous timestamp tau_i or t_e (in days) used for strict causal filtering (t_e &lt; tau_i) and exponential decay alpha(tau_i, t_e).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasCanonicalEntityId">
        <rdfs:label>hasCanonicalEntityId</rdfs:label>
        <rdfs:comment>Unique canonical identifier under the Unique Name Assumption (UNA) used to evaluate instance-level irreflexivity (e_h != e_t).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasTypingEntropy">
        <rdfs:label>hasTypingEntropy</rdfs:label>
        <rdfs:comment>Normalized Shannon entropy H(pi(e)) in [0, 1] of the NER concept distribution, governing the adaptive soft-mask gate (tau_ent = 0.65).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasDecayWeight">
        <rdfs:label>hasDecayWeight</rdfs:label>
        <rdfs:comment>Exponential temporal interaction decay weight alpha(tau_i, t_e) = exp(-gamma * (tau_i - t_e)).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>

    <!-- ===================================================================== -->
    <!-- 5. Closed-World SHACL Integrity Shapes S (Equation 11 & Section 3.2.1) -->
    <!-- ===================================================================== -->

    <sh:NodeShape rdf:about="#MessageIntegrityShape">
        <rdfs:label>MessageIntegrityShape</rdfs:label>
        <rdfs:comment>Closed-world SHACL validation shape enforcing functional upper-bound cardinalities (&lt;= 1 author and &lt;= 1 sentiment) on every Message instance.</rdfs:comment>
        <sh:targetClass rdf:resource="#Message"/>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#authored_by"/>
                <sh:class rdf:resource="#User"/>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
        <sh:property>
            <sh:PropertyShape>
                <sh:path rdf:resource="#expresses_sentiment"/>
                <sh:class rdf:resource="#Sentiment"/>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
            </sh:PropertyShape>
        </sh:property>
    </sh:NodeShape>

    <sh:NodeShape rdf:about="#UserFollowsIrreflexiveShape">
        <rdfs:label>UserFollowsIrreflexiveShape</rdfs:label>
        <rdfs:comment>Closed-world SHACL validation shape enforcing Irreflexive(follows): no User u may satisfy follows(u, u) under canonical entity resolution.</rdfs:comment>
        <sh:targetClass rdf:resource="#User"/>
        <sh:sparql>
            <sh:SPARQLConstraint>
                <sh:message>Reflexive self-follow relation follows(u, u) violates Irreflexive(follows).</sh:message>
                <sh:select>SELECT $this WHERE { $this &lt;http://hykga.org/ontology/social_discourse#follows&gt; $this . }</sh:select>
            </sh:SPARQLConstraint>
        </sh:sparql>
    </sh:NodeShape>

    <!-- ===================================================================== -->
    <!-- 6. SWRL Rules for Background Interaction Deduction (Section 3.1)       -->
    <!-- ===================================================================== -->

    <!-- SWRL Rule 1: retweets(?u1, ?m) ^ authored_by(?m, ?u2) ^ differentFrom(?u1, ?u2) -> interacts_with(?u1, ?u2) -->
    <swrl:Imp rdf:about="#RetweetImpliesInteractionRule">
        <rdfs:label>RetweetImpliesInteractionRule</rdfs:label>
        <rdfs:comment>If user u1 retweets a message m authored by a distinct user u2, then u1 interacts_with u2.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#retweets"/>
                <swrl:argument1 rdf:resource="urn:swrl#u1"/>
                <swrl:argument2 rdf:resource="urn:swrl#m"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#authored_by"/>
                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:IndividualPropertyAtom>
            <swrl:DifferentIndividualsAtom>
                <swrl:argument1 rdf:resource="urn:swrl#u1"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:DifferentIndividualsAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#interacts_with"/>
                <swrl:argument1 rdf:resource="urn:swrl#u1"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>

    <!-- SWRL Rule 2: authored_by(?m, ?u1) ^ mentions(?m, ?u2) ^ User(?u2) ^ differentFrom(?u1, ?u2) -> interacts_with(?u1, ?u2) -->
    <swrl:Imp rdf:about="#UserMentionImpliesInteractionRule">
        <rdfs:label>UserMentionImpliesInteractionRule</rdfs:label>
        <rdfs:comment>If user u1 authors a message m that mentions another distinct user u2, then u1 interacts_with u2.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#authored_by"/>
                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                <swrl:argument2 rdf:resource="urn:swrl#u1"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#mentions"/>
                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:IndividualPropertyAtom>
            <swrl:ClassAtom>
                <swrl:classPredicate rdf:resource="#User"/>
                <swrl:argument1 rdf:resource="urn:swrl#u2"/>
            </swrl:ClassAtom>
            <swrl:DifferentIndividualsAtom>
                <swrl:argument1 rdf:resource="urn:swrl#u1"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:DifferentIndividualsAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#interacts_with"/>
                <swrl:argument1 rdf:resource="urn:swrl#u1"/>
                <swrl:argument2 rdf:resource="urn:swrl#u2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>

    <!-- SWRL Rule 3: mentions(?m, ?e) ^ Event(?e) ^ located_in(?e, ?loc) -> located_in(?m, ?loc) -->
    <swrl:Imp rdf:about="#EventLocationPropagationRule">
        <rdfs:label>EventLocationPropagationRule</rdfs:label>
        <rdfs:comment>If a message m mentions an event e that is located_in location loc, then m is contextually associated with loc.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#mentions"/>
                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                <swrl:argument2 rdf:resource="urn:swrl#e"/>
            </swrl:IndividualPropertyAtom>
            <swrl:ClassAtom>
                <swrl:classPredicate rdf:resource="#Event"/>
                <swrl:argument1 rdf:resource="urn:swrl#e"/>
            </swrl:ClassAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#located_in"/>
                <swrl:argument1 rdf:resource="urn:swrl#e"/>
                <swrl:argument2 rdf:resource="urn:swrl#loc"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#located_in"/>
                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                <swrl:argument2 rdf:resource="urn:swrl#loc"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>

</rdf:RDF>
